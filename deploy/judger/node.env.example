# KECE 专池节点环境变量模板
JUDGE_POOL=python
JUDGE_CONTROL_URL=https://judger-control.example.internal:8443/api/v1
JUDGE_HEALTH_PORT=19091
JUDGE_API_BIND=0.0.0.0
JUDGE_HOST_IDENTITY_DIR=/var/lib/kece-judger/identity
JUDGE_LOCAL_SLOTS=2
JUDGE_RUNTIME_SPEC=python-v1
JUDGE_RUNTIME_VERSION=3.12
JUDGE_HOST_WORKSPACE=/data/kece-judge/work-python-1
JUDGE_ARTIFACT_CACHE_LIMIT_MB=2048
IMAGE_PYTHON=python:3.12-slim
