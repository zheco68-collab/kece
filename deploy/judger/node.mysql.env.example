# KECE MySQL 专池节点环境变量模板
JUDGE_POOL=mysql
JUDGE_CONTROL_URL=https://judger-control.example.internal:8443/api/v1
JUDGE_HEALTH_PORT=19094
JUDGE_API_BIND=0.0.0.0
JUDGE_HOST_IDENTITY_DIR=/var/lib/kece-judger/identity
JUDGE_LOCAL_SLOTS=2
JUDGE_RUNTIME_SPEC=mysql-v1
JUDGE_RUNTIME_VERSION=8.0.36
JUDGE_HOST_WORKSPACE=/data/kece-judge/work-mysql-1
JUDGE_ARTIFACT_CACHE_LIMIT_MB=2048
# 专用判题 MySQL 独立实例（禁止指向业务库）
JUDGE_MYSQL_HOST=judge-mysql.example.internal
JUDGE_MYSQL_PORT=3307
JUDGE_MYSQL_USER=judge_admin
JUDGE_MYSQL_PASSWORD=judge_secret_password
