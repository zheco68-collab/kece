# KECE C++ 专池节点环境变量模板
JUDGE_POOL=cpp
JUDGE_CONTROL_URL=https://judger-control.example.internal:8443/api/v1
JUDGE_HEALTH_PORT=19091
JUDGE_API_BIND=0.0.0.0
JUDGE_HOST_IDENTITY_DIR=/var/lib/kece-judger/identity
JUDGE_LOCAL_SLOTS=2
JUDGE_RUNTIME_SPEC=cpp-v1
JUDGE_RUNTIME_VERSION=gcc-13
JUDGE_HOST_WORKSPACE=/data/kece-judge/work-cpp-1
JUDGE_ARTIFACT_CACHE_LIMIT_MB=4096
IMAGE_CPP=gcc:13
